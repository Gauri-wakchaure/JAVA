public class break_continue {

public static void main(String[] args) {
// Break & Continue Keyword: Use to break and continue statements
        int i=0;
        while(true){
            if(i == 3){
                i = i+1;
                continue;
            }
            System.out.println(i);
            i = i +1;
            if(i > 5){
                break;
            }
        }
    }
}